# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# Virtual environments
venv/
.venv/
env/
.env/

# Environment variables
.env
.env.*
!.env.example

# ─── Raw Mission Data (never commit) ──────────────────────────────────────────
data/raw/*
!data/raw/.gitkeep
data/raw/hel1os/*
!data/raw/hel1os/.gitkeep

# ─── ML Models (versioned artifacts, can be large) ───────────────────────────
models/*.pkl
models/*.joblib
models/*.json
!models/.gitkeep
models/versions/

# ─── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.npm

# ─── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
